# Cloudflare API token with "Zone > Analytics > Read" (and "Account > Account Analytics > Read"
# if you use account-level datasets) scoped to the zone below.
# Create one at: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# Account ID - found on the Cloudflare dashboard's zone Overview page, right-hand sidebar.
CF_ACCOUNT_ID=

# Zone ID - found on the same Overview page, right above Account ID.
CF_ZONE_ID=

# Human-readable label used to name export folders, e.g. "aggie-experts".
# Falls back to CF_ZONE_ID if left blank.
CF_APP_NAME=

# Optional overrides - safe to leave commented out.
# CF_API_BASE_URL=https://api.cloudflare.com/client/v4/graphql
# CF_REQUEST_TIMEOUT_MS=30000

# Minimum Cloudflare Bot Score (0-100) treated as "human" (scores below this are "bot").
# Only meaningful on zones with Bot Management enabled.
# CF_BOT_SCORE_THRESHOLD=30

# Path prefix counted as an "API call" for the api-calls view.
# CF_API_PATH_PREFIX=/api/

# HTTP status class all views are filtered to (2xx, 3xx, 4xx, 5xx, or 1xx).
# CF_STATUS_CLASS=2xx

# Default lookback window (days) when no --days/--start/--end flag is given.
# AE_AF_DEFAULT_DAYS=30

# Default row limit for the top-pages view.
# AE_AF_TOP_PAGES_LIMIT=50

# Parent directory export folders are created in. Defaults to the current directory.
# AE_AF_OUTPUT_DIR=.

# GCS bucket to upload the zip to when --zip is set (overridable with --gcs-bucket).
# Leave blank to only write the zip locally. Requires GOOGLE_APPLICATION_CREDENTIALS
# (or ambient ADC) with write access to the bucket.
# AE_AF_GCS_BUCKET=

# Set to true for verbose debug logging.
# AE_AF_DEBUG=false
